# ------------------------------------------------------------------
# SmartPay Connect — environment variables
# Copy to .env.local (Next.js) and .env (scripts). NEVER commit real values.
# ------------------------------------------------------------------

# PostgreSQL (Neon). Use the POOLED connection string for the app on Vercel.
# Example: postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/smartpay?sslmode=require
DATABASE_URL=postgresql://smartpay:smartpay@localhost:5432/smartpay

# Separate database used ONLY by integration tests (it is wiped by the test suite).
TEST_DATABASE_URL=postgresql://smartpay:smartpay@localhost:5432/smartpay_test

# Public base URL — used in the permanent QR code and absolute links.
APP_URL=http://localhost:3000

# 32+ random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48

# HMAC secret used to sign/verify MOCK provider webhooks.
MOCK_WEBHOOK_SECRET=change-me-mock-webhook-secret

# Salt for hashing IP addresses in audit logs / rate limits (privacy).
IP_HASH_SALT=change-me-ip-hash-salt

# Payment provider. V1 only allows "mock". Real adapters are hard-disabled in code.
PAYMENT_PROVIDER=mock

# Demo seed passwords (only read by scripts/seed.ts). Set strong values before any shared demo.
SEED_FINANCE_PASSWORD=Finance#Demo2026
SEED_OWNER_PASSWORD=Owner#Demo2026
